# 嵌入式 Python 运行时（可用 setup-runtime.cmd 重建）
runtime/

# WebView2 用户目录（localStorage：主题/令牌/上次会话）
userdata/

# 构建/安装期临时文件（setup-runtime.mjs 把子进程 TEMP 定向到这里）
.tmp/

# 应用启动时的转图临时目录（TEMP 缺失时会落到当前目录，见本地部署说明.md）
mopai_img_*/

# 参考项目（不属于本产品）
obsidian-md2wechat-main/
markdown-online-editor-master/
md2wechat-skill-main/
md-to-weixin-main/
research/

# 开发工具链
node_modules/
.playwright-mcp/
package.json
package-lock.json

# 调试产物
app-debug.log
__pycache__/
*.pyc

# 测试数据（不提交；开发工具 test/cdp_eval.py、test/code2img-smoke.html 仍跟踪）
# 端到端验证用的样例文章（含图片）
test/sample-article/
# 测试输入文档（如 GPT 导出的测试文本）
test/*.docx
test/*.pdf
# 测试截图 / 渲染输出图
test/*.png
test/*.jpg
test/*.jpeg
test/*.gif
test/*.webp
# 测试用压缩包
test/*.zip

# 个人工具（Claude Code 会话与本机启动器）
.claude/
__启动脚本.bat
